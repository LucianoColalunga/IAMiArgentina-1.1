# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Las claves se generan con:  docker compose run --rm --no-deps api gen-secrets
# (antes del primer "up": PostgreSQL fija su contraseña la primera vez que arranca)
# En producción los secretos vienen del gestor de secretos (Vault / External Secrets), no de un archivo.

# ------------------------------------------------------------------ general
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080

# ------------------------------------------------------------------ contraseñas de la infraestructura local
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# ------------------------------------------------------------------ cifrado y seudonimización (obligatorias)
# Formato: id:base64 (32 bytes). Para rotar: la clave nueva primero, las anteriores detrás.
DATA_ENCRYPTION_KEYS=
PSEUDONYMIZATION_KEY=
EDGE_SHARED_SECRET=

# ------------------------------------------------------------------ modelos (API compatible con OpenAI)
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
LLM_API_KEY=
EMBEDDINGS_BASE_URL=http://embeddings:8000/v1
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
LOCAL_MODELS_API_KEY=

# ------------------------------------------------------------------ canales
# whatsapp, telegram, instagram, messenger, x, webchat, email, sms
CHANNELS_ENABLED=webchat
WEBCHAT_TOKEN_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REENGAGEMENT_TEMPLATE=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

X_ACCOUNT_ID=
X_WEBHOOK_SECRET=
X_TOKEN_MODE=refresh
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=

EMAIL_INBOUND_SECRET=
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=

# ------------------------------------------------------------------ consola de operadores (OIDC)
# Producción: JWKS del proveedor de identidad. Desarrollo: clave pública de `iamia dev-token`.
OIDC_ISSUER=
OIDC_AUDIENCE=iamia-admin
OIDC_JWKS_URL=
OIDC_PUBLIC_KEY_PATH=
