# Secretos de la observabilidad (compose.observability.yml). Van en un archivo aparte del .env
# de la aplicación para que no lleguen a los contenedores de la API y los workers:
#
#   cp .env.observability.example .env.observability   (completar y no versionar)
#   docker compose --env-file .env --env-file .env.observability \
#     -f docker-compose.yml -f compose.observability.yml up -d

# Contraseña del usuario admin de Grafana (escucha solo en 127.0.0.1:3000).
GRAFANA_ADMIN_PASSWORD=
# Credenciales de Alertmanager: se montan como archivos, nunca van en el YAML versionado.
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_GUARDIA_WEBHOOK_URL=
# Fracción de mensajes con traza (1.0 = todos). Con mucho tráfico, 0.1 alcanza.
OTEL_TRACES_SAMPLE_RATIO=1.0
