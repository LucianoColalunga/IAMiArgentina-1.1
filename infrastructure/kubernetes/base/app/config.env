# Configuración no secreta. kustomize genera el ConfigMap iamia-config con un hash en el nombre:
# cualquier cambio acá dispara un rollout de los pods que lo usan.
# Los secretos van en iamia-secrets (External Secrets, ver externalsecret.yaml).

APP_ENV=production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://asistente.example.org
CHANNELS_ENABLED=whatsapp,telegram,instagram,messenger,x,webchat,email,sms

# Modelos (servicios vLLM del mismo namespace)
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
EMBEDDINGS_BASE_URL=http://embeddings:8000/v1
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Consola: tokens OIDC del IdP. El aud del token tiene que ser OIDC_AUDIENCE.
OIDC_ISSUER=https://idp.example.org/realms/iamia
OIDC_JWKS_URL=https://idp.example.org/realms/iamia/protocol/openid-connect/certs
OIDC_AUDIENCE=iamia-admin

METRICS_PORT=9100
# Un proceso por pod: se escala con réplicas y las métricas no necesitan modo multiproceso.
WEB_CONCURRENCY=1
# Conexiones por pod. Con el pooler en modo sesión cada conexión ocupa una del servidor:
# (réplicas máximas de todos los roles) x DB_POOL_MAX_SIZE tiene que entrar en el pooler.
DB_POOL_MAX_SIZE=10
# Detrás del pooler el statement_timeout lo fija el rol en la base (postgres/cluster.yaml).
DB_STATEMENT_TIMEOUT_MS=5000
# Solo el ingress controller y oauth2-proxy llegan a la API (NetworkPolicy), así que las
# cabeceras X-Forwarded-*/X-Real-IP que recibe son confiables.
TRUST_PROXY_HEADERS=true

# Identificadores de los canales (no son secretos, pero son propios de cada cuenta)
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
INSTAGRAM_ACCOUNT_ID=CHANGE_ME
MESSENGER_PAGE_ID=CHANGE_ME
X_ACCOUNT_ID=CHANGE_ME
X_CLIENT_ID=CHANGE_ME
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_FROM_NUMBER=CHANGE_ME
# Twilio firma con la URL completa: tiene que ser la pública, tal cual la configura la consola.
SMS_WEBHOOK_URL=https://asistente.example.org/webhooks/sms
SMTP_HOST=smtp.example.org
SMTP_PORT=587
EMAIL_FROM_ADDRESS=asistente@example.org

# Trazas: OTLP/HTTP del colector de OpenTelemetry del cluster (vacío = sin trazas). Con el
# volumen de producción alcanza con muestrear el 10 % de los mensajes.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=0.1
