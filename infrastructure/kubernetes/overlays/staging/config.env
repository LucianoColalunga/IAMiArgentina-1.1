# Diferencias de configuración de staging (se combinan con base/app/config.env).
APP_ENV=staging
PUBLIC_BASE_URL=https://asistente.staging.example.org
SMS_WEBHOOK_URL=https://asistente.staging.example.org/webhooks/sms
OIDC_ISSUER=https://idp.example.org/realms/iamia-staging
OIDC_JWKS_URL=https://idp.example.org/realms/iamia-staging/protocol/openid-connect/certs
# Menos réplicas: alcanza con pools más chicos.
DB_POOL_MAX_SIZE=5
